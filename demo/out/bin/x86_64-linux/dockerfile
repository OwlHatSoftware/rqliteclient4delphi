# Start with the Alpine latest Docker image.
FROM alpine:latest

#ENV API-HOSTNAME=localhost
#ENV API-PORT=8080
ENV RQLITE-HOSTNAME=localhost
ENV RQLITE-PORT=4001 

# Install libc6-compat, required for executables generated by FPC.
RUN apk --no-cache --update add libc6-compat
# Since we are using SQLite as a database we must install the libs and create a
# symlink to libsqlite3.so to make SQLDB work! 
#RUN apk add --no-cache sqlite-libs
#RUN ln -s /usr/lib/libsqlite3.so.0 /usr/lib/libsqlite3.so

# Set working directory in the container image.
WORKDIR /usr/local/bin/

# Copy the executable from host into container image.
COPY democontainer /usr/local/bin/democontainer
COPY ca-certificate.crt /usr/local/bin/ca-certificate.crt

# Add uid/gid to run the binary. Don't want to run as root.
RUN addgroup -g 1099 apprunner \
&& adduser -D -u 1099 -G apprunner -h /home/apprunner apprunner

# Set uid/gid for the running program.
USER apprunner:apprunner

# Make the TCP port 8080 available to outside the container.
EXPOSE 8080

# Run the program.
CMD ["democontainer"]