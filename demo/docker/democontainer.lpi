      </Unit>
      <Unit>
        <Filename Value="..\..\src\urqlite.client.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\..\..\horse\src\Horse.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="..\..\..\horse-logger\src\Horse.Logger.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
